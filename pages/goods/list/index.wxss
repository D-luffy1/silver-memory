page {
  background: #f5f6f8;
}

.fl {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ---------- 吸顶搜索/筛选区 ---------- */
.fl__header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(17, 24, 32, 0.05);
}

.fl__search {
  padding: 20rpx 24rpx 12rpx;
}

.fl__search-box {
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 20rpx;
  background: #f2f4f7;
  border-radius: 34rpx;
}

.fl__search-input {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #1f2329;
}

.fl__search-ph {
  font-size: 26rpx;
  color: #9aa2ad;
}

.fl__search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #c4c9d1;
}

/* 分类标签 */
.fl__cats {
  width: 100%;
  white-space: nowrap;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.fl__cat {
  display: inline-flex;
  align-items: baseline;
  margin-right: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #4e5969;
  border-radius: 28rpx;
  background: #f2f4f7;
  transition: all 0.2s;
}

.fl__cat:last-child {
  margin-right: 0;
}

.fl__cat.is-active {
  color: #fff;
  font-weight: 500;
  background: linear-gradient(90deg, #ff5f15, #ff8b3d);
}

.fl__cat-num {
  margin-left: 6rpx;
  font-size: 20rpx;
  opacity: 0.8;
}

/* 排序条 */
.fl__sorts {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f2f4f7;
}

.fl__sort {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: center;
  font-size: 26rpx;
  color: #4e5969;
}

.fl__sort.is-active {
  color: #ff5f15;
  font-weight: 600;
}

.fl__sort-arrow {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: #c4c9d1;
}

.fl__sort.is-active .fl__sort-arrow {
  color: #ff5f15;
}

.fl__sort--filter {
  position: relative;
  flex: none;
  padding-left: 24rpx;
  margin-left: 8rpx;
  border-left: 1rpx solid #eee;
}

.fl__sort-badge {
  position: absolute;
  top: -6rpx;
  right: -8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  color: #fff;
  border-radius: 14rpx;
  background: #ff4b2b;
}

/* ---------- 结果统计 ---------- */
.fl__summary {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 20rpx 24rpx 4rpx;
}

.fl__summary-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff5f15;
}

.fl__summary-unit {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: #86909c;
}

.fl__tags {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  margin-top: 12rpx;
}

.fl__tag {
  display: flex;
  align-items: center;
  margin: 0 12rpx 12rpx 0;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  color: #d96a2b;
  background: #fff3ec;
  border-radius: 8rpx;
}

.fl__tag text {
  margin-right: 6rpx;
}

/* ---------- 列表主体 ---------- */
.fl__body {
  padding: 24rpx;
}

.fl__state,
.fl__empty {
  padding: 100rpx 0 40rpx;
  text-align: center;
}

.fl__state-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 0 40rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  color: #fff;
  border-radius: 34rpx;
  background: linear-gradient(90deg, #ff5f15, #ff8b3d);
}

.fl__more {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #aeb4be;
}

/* 骨架 */
.fl__skeleton {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.fl__sk-card {
  width: calc(50% - 8rpx);
  height: 400rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #eef1f5 25%, #f7f9fb 37%, #eef1f5 63%);
  background-size: 400% 100%;
  animation: fl-skeleton 1.4s ease infinite;
}

@keyframes fl-skeleton {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* ---------- 筛选抽屉 ---------- */
.fp {
  display: flex;
  flex-direction: column;
  max-height: 76vh;
  padding-bottom: calc(env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
}

.fp__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx 16rpx;
}

.fp__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.fp__reset {
  font-size: 26rpx;
  color: #86909c;
}

.fp__body {
  flex: 1;
  max-height: 52vh;
  padding: 0 30rpx;
}

.fp__group {
  padding: 20rpx 0;
  border-top: 1rpx solid #f2f4f7;
}

.fp__label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2329;
}

.fp__chips {
  display: flex;
  flex-wrap: wrap;
}

.fp__chip {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 26rpx;
  font-size: 24rpx;
  color: #4e5969;
  background: #f2f4f7;
  border-radius: 28rpx;
  border: 1rpx solid transparent;
}

.fp__chip.is-on {
  color: #ff5f15;
  font-weight: 500;
  background: #fff3ec;
  border-color: #ffb688;
}

.fp__foot {
  display: flex;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f2f4f7;
}

.fp__btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  margin-right: 20rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 42rpx;
}

.fp__btn:last-child {
  margin-right: 0;
}

.fp__btn--cancel {
  flex: 0 0 200rpx;
  color: #4e5969;
  background: #f2f4f7;
}

.fp__btn--confirm {
  color: #fff;
  font-weight: 500;
  background: linear-gradient(90deg, #ff5f15, #ff8b3d);
  box-shadow: 0 8rpx 20rpx rgba(255, 95, 21, 0.28);
}
