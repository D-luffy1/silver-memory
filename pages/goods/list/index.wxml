<view class="fl">
  <view class="fl__header">
    <!-- 搜索 -->
    <view class="fl__search">
      <view class="fl__search-box">
        <t-icon prefix="wr" name="search" size="28rpx" color="#9aa2ad" />
        <input
          class="fl__search-input"
          value="{{keyword}}"
          placeholder="搜小区名 / 地址 / 户型 / 特色"
          placeholder-class="fl__search-ph"
          confirm-type="search"
          focus="{{focusSearch}}"
          bindinput="onSearchInput"
          bindblur="onSearchBlur"
        />
        <view wx:if="{{keyword}}" class="fl__search-clear" bind:tap="onSearchClear">
          <t-icon prefix="wr" name="close" size="20rpx" color="#fff" />
        </view>
      </view>
    </view>

    <!-- 分类 -->
    <scroll-view class="fl__cats" scroll-x enable-flex>
      <view
        class="fl__cat {{activeCategory === item.value ? 'is-active' : ''}}"
        wx:for="{{categories}}"
        wx:key="value"
        data-value="{{item.value}}"
        bind:tap="onCategoryChange"
      >
        <text>{{item.label}}</text>
        <text class="fl__cat-num" wx:if="{{item.count}}">{{item.count}}</text>
      </view>
    </scroll-view>

    <!-- 排序 + 筛选 -->
    <view class="fl__sorts">
      <view
        class="fl__sort {{sortField === item.field ? 'is-active' : ''}}"
        wx:for="{{sortItems}}"
        wx:key="field"
        data-field="{{item.field}}"
        bind:tap="onSortChange"
      >
        <text>{{item.label}}</text>
        <text class="fl__sort-arrow" wx:if="{{item.field !== 'default'}}">
          {{sortField === item.field ? (sortOrder === 'asc' ? '↑' : '↓') : '↕'}}
        </text>
      </view>
      <view class="fl__sort fl__sort--filter {{activeFilterCount ? 'is-active' : ''}}" bind:tap="onFilterOpen">
        <text>筛选</text>
        <t-icon prefix="wr" name="filter" size="24rpx" color="{{activeFilterCount ? '#ff5f15' : '#6b7280'}}" />
        <text class="fl__sort-badge" wx:if="{{activeFilterCount}}">{{activeFilterCount}}</text>
      </view>
    </view>
  </view>

  <!-- 结果统计与已选条件 -->
  <view class="fl__summary" wx:if="{{!loading && !failed}}">
    <view class="fl__summary-left">
      <text class="fl__summary-num">共 {{total}}</text>
      <text class="fl__summary-unit">套房源</text>
    </view>
    <view class="fl__tags" wx:if="{{appliedTags.length}}">
      <view
        class="fl__tag"
        wx:for="{{appliedTags}}"
        wx:key="label"
        data-type="{{item.type}}"
        data-value="{{item.value}}"
        bind:tap="onTagRemove"
      >
        <text>{{item.label}}</text>
        <t-icon prefix="wr" name="close" size="18rpx" color="#d96a2b" />
      </view>
    </view>
  </view>

  <!-- 列表主体 -->
  <view class="fl__body">
    <!-- 加载失败 -->
    <view wx:if="{{failed}}" class="fl__state">
      <t-empty description="房源加载失败" />
      <view class="fl__state-btn" bind:tap="onRetry">重新加载</view>
    </view>

    <block wx:else>
      <!-- 首屏骨架 -->
      <view wx:if="{{loading && !list.length}}" class="fl__skeleton">
        <view class="fl__sk-card" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
      </view>

      <block wx:else>
        <property-list
          wx:if="{{list.length}}"
          list="{{list}}"
          variant="grid"
          bind:click="gotoDetail"
          bind:thumb="previewImages"
        />

        <view class="fl__empty" wx:if="{{!list.length}}">
          <t-empty description="没有符合条件的房源" />
          <view class="fl__state-btn" bind:tap="onClearAll">清空筛选条件</view>
        </view>

        <view class="fl__more" wx:if="{{list.length && noMore}}">— 已经到底啦，共 {{total}} 套 —</view>
        <view class="fl__more" wx:elif="{{list.length && loading}}">正在加载更多…</view>
      </block>
    </block>
  </view>
</view>

<!-- 筛选抽屉 -->
<t-popup visible="{{filterVisible}}" placement="bottom" bind:visible-change="onFilterClose">
  <view class="fp">
    <view class="fp__head">
      <text class="fp__title">筛选房源</text>
      <view class="fp__reset" bind:tap="onFilterReset">重置</view>
    </view>

    <scroll-view class="fp__body" scroll-y>
      <view class="fp__group" wx:if="{{houseTypeOptions.length}}">
        <text class="fp__label">户型</text>
        <view class="fp__chips">
          <view
            class="fp__chip {{item.isOn ? 'is-on' : ''}}"
            wx:for="{{houseTypeOptions}}"
            wx:key="label"
            data-value="{{item.label}}"
            bind:tap="onFilterHouseTypeTap"
          >
            {{item.label}}
          </view>
        </view>
      </view>

      <view class="fp__group">
        <text class="fp__label">价格</text>
        <view class="fp__chips">
          <view
            class="fp__chip {{draftPriceIndex === index ? 'is-on' : ''}}"
            wx:for="{{priceOptions}}"
            wx:key="label"
            data-index="{{index}}"
            bind:tap="onFilterPriceTap"
          >
            {{item.label}}
          </view>
        </view>
      </view>

      <view class="fp__group">
        <text class="fp__label">面积</text>
        <view class="fp__chips">
          <view
            class="fp__chip {{draftAreaIndex === index ? 'is-on' : ''}}"
            wx:for="{{areaOptions}}"
            wx:key="label"
            data-index="{{index}}"
            bind:tap="onFilterAreaTap"
          >
            {{item.label}}
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="fp__foot">
      <view class="fp__btn fp__btn--cancel" bind:tap="onFilterClose">取消</view>
      <view class="fp__btn fp__btn--confirm" bind:tap="onFilterConfirm">确定</view>
    </view>
  </view>
</t-popup>
