page {
  background: #f5f6f8;
}

.home {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ---------- 品牌头部 ---------- */
.home__hero {
  padding: 28rpx 30rpx 24rpx;
  background: linear-gradient(160deg, #ff5f15 0%, #ff7f2f 55%, #ff9b4d 100%);
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 95, 21, 0.18);
}

.home__brand-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  line-height: 60rpx;
  letter-spacing: 2rpx;
}

.home__brand-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.home__search {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 0 24rpx;
  height: 72rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
}

.home__search-ph {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #9aa2ad;
}

.home__stats {
  display: flex;
  margin-top: 22rpx;
}

.home__stat {
  flex: 1;
  text-align: center;
}

.home__stat + .home__stat {
  border-left: 1rpx solid rgba(255, 255, 255, 0.3);
}

.home__stat-line {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.home__stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
  font-family: DIN Alternate, 'Helvetica Neue', Arial, sans-serif;
}

.home__stat-unit {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
}

.home__stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ---------- 分类入口 ---------- */
.home__cats {
  display: flex;
  justify-content: space-between;
  padding: 26rpx 24rpx 6rpx;
}

.home__cat {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 158rpx;
  padding: 20rpx 0 16rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(17, 24, 32, 0.05);
}

.home__cat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  margin-bottom: 12rpx;
}

.home__cat-icon--0 {
  background: linear-gradient(135deg, #ff7a45, #ff5f15);
}

.home__cat-icon--1 {
  background: linear-gradient(135deg, #40a9ff, #1677ff);
}

.home__cat-icon--2 {
  background: linear-gradient(135deg, #73d13d, #389e0d);
}

.home__cat-icon--more {
  background: linear-gradient(135deg, #9254de, #722ed1);
}

.home__cat-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2329;
}

.home__cat-count {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9aa2ad;
}

/* ---------- 轮播 ---------- */
.home__swiper-wrap {
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(17, 24, 32, 0.06);
}

/* ---------- 分区 ---------- */
.home__section {
  margin-top: 32rpx;
  padding: 0 24rpx;
}

.home__section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.home__section-title {
  position: relative;
  padding-left: 18rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.home__section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #ff5f15, #ff9b4d);
}

.home__section-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #9aa2ad;
}

.home__section-desc {
  font-size: 22rpx;
  color: #9aa2ad;
}

.home__scroll {
  width: 100%;
  white-space: nowrap;
}

/* ---------- 加载 / 空态 ---------- */
.home__loading {
  padding: 40rpx 24rpx 0;
  text-align: center;
  color: #9aa2ad;
}

.home__sk-line {
  height: 24rpx;
  margin: 32rpx 0 24rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #eef1f5 25%, #f7f9fb 37%, #eef1f5 63%);
  background-size: 400% 100%;
  animation: home-skeleton 1.4s ease infinite;
}

.home__sk-line--lg {
  width: 60%;
  margin-left: auto;
  margin-right: auto;
}

.home__sk-row {
  display: flex;
  justify-content: space-between;
}

.home__sk-card {
  width: calc(50% - 8rpx);
  height: 380rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #eef1f5 25%, #f7f9fb 37%, #eef1f5 63%);
  background-size: 400% 100%;
  animation: home-skeleton 1.4s ease infinite;
}

@keyframes home-skeleton {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.home__state,
.home__empty {
  padding: 100rpx 0 40rpx;
  text-align: center;
}

.home__state-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 0 40rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  color: #fff;
  border-radius: 34rpx;
  background: linear-gradient(90deg, #ff5f15, #ff8b3d);
}
